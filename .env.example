# ============================================================
# Environment Variables for Spring AI MCP POC
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Active LLM Provider ("copilot" or "antigravity") ---
AI_PROVIDER=copilot

# --- Antigravity CLI Provider (Gemini / Claude via agy CLI) ---
ANTIGRAVITY_ENABLED=true
ANTIGRAVITY_COMMAND=agy
ANTIGRAVITY_MODEL=gemini-3.8-flash-high
ANTIGRAVITY_TIMEOUT_SECONDS=120

# --- GitHub Copilot SDK ---
COPILOT_SDK_ENABLED=true
COPILOT_MODEL=gpt-5
COPILOT_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# --- OpenAI-compatible fallback (OpenRouter / Azure / etc.) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash

# --- GitHub Enterprise token (for Git MCP server / dashboard) ---
GITHUB_ENTERPRISE_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxx

# --- JFrog ---
JFROG_URL=https://global-artifacts.se.com
JFROG_ACCESS_TOKEN=your-jfrog-access-token

# --- Jira ---
JIRA_URL=https://jira.se.com
JIRA_EMAIL=your-email@schneider-electric.com
JIRA_API_TOKEN=your-jira-api-token

# --- Confluence ---
CONFLUENCE_URL=https://jira.se.com/wiki
CONFLUENCE_EMAIL=your-email@schneider-electric.com
CONFLUENCE_API_TOKEN=your-confluence-api-token

# --- ServiceNow ---
SERVICENOW_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=your-username
SERVICENOW_PASSWORD=your-password

# --- Dashboard (uses GitHub Enterprise token above) ---
